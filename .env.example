# Generate two different secrets with: uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'
SAUDA_API_TOKEN=
SAUDA_WEBHOOK_SECRET=
BOLNA_API_KEY=
SAUDA_LIVE_CALLS_ENABLED=false
# Comma-separated verified, consenting test recipients in E.164 format. Keep private.
SAUDA_ALLOWED_NUMBERS=
SAUDA_DISPATCH_CONCURRENCY=2
SAUDA_DATABASE=private/sauda.sqlite3
# Neon pooled PostgreSQL URL for hosted deployments; takes priority over SAUDA_DATABASE.
# Keep the provider's sslmode=require and channel_binding=require parameters.
DATABASE_URL=
